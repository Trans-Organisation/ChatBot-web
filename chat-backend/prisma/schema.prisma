datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Message {
    id        String   @id @default(uuid())
    content   String
    sender    String
    sessionId String
    createdAt DateTime @default(now())
}

model DocumentChunk {
  id        String                 @id @default(uuid())
  content   String                                          // Le texte de l'extrait
  metadata  Json?                                           // Titre du doc, numéro de page, etc.
  embedding Unsupported("vector(1024)")?                    // Vecteur Mistral (1024 dims)
  createdAt DateTime               @default(now())

  @@map("document_chunks")
}